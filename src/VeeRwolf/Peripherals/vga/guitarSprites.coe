; ============================================================================
; File:        guitarSprites.coe
; Author:      Jacob Burtenshaw
; Date:        2026-05-23
; Description: Vivado BRAM initialization file for unified sprite ROM used by
;              wb_vga.sv. Contains both bigfont glyph bitmaps (IDs 0-94) and
;              Guitar Hero-style game sprites (IDs 95-111).
;
;              BRAM Configuration:
;                memory_initialization_radix = 16 (hex)
;                Data width  = 32 bits per entry
;                Depth       = 4096 entries (128 sprite slots x 32 rows each)
;
;              Bit ordering (MSB -> LSB):
;                Bit 31 = leftmost pixel (x=0)
;                Bit  0 = rightmost pixel (x=31)
;
;              Addressing:
;                ROM address = (sprite_id * 32) + row_y
;
;              Font glyph format (IDs 0-94, sprite_type=1 i.e. 16x16):
;                Each glyph row stored as {glyph_row_16bit, 16'h0000}.
;                Pixels occupy bits 31..16; bits 15..0 are always zero.
;                Only rows 0-15 contain glyph data; rows 16-31 are zero.
;                sprite_type=1 constrains the compositor to check only
;                col_offset < 16 (renders 16px wide) and row < y_pos+16.
;
;              Sprite ID table — bigfont glyphs (IDs 0-94):
;                ID = ASCII_code - 32  (space=0, '!'=1, ... '~'=94)
;
;              Sprite ID table — guitar sprites (IDs 95-111):
;   0x5F (3040)  Large Chord Circle    - solid   - 32x32
;   0x60 (3072)  Large Chord Circle    - hollow  - 32x32
;   0x61 (3104)  Small Note Circle     - solid   - 16x16 (upper 16 bits)
;   0x62 (3136)  Small Note Circle     - hollow  - 16x16 (upper 16 bits)
;   0x63 (3168)  Squiggly Trail        - solid   - 16x32 (upper 16 bits)
;   0x64 (3200)  Squiggly Trail        - hollow  - 16x32 (upper 16 bits)
;   0x65 (3232)  Horizontal Bar        - solid   - 32x8
;   0x66 (3264)  Horizontal Bar        - hollow  - 32x8
;   0x67 (3296)  Vertical Separator    - solid   - 4x32
;   0x68 (3328)  Vertical Separator    - hollow  - 4x32
;   0x69 (3360)  Top-Left Corner       - hollow  - 8x8 (upper-left of 32x32)
;   0x6A (3392)  Top-Right Corner      - hollow  - 8x8 (upper-right of 32x32)
;   0x6B (3424)  Bottom-Left Corner    - hollow  - 8x8 (upper-left of 32x32)
;   0x6C (3456)  Bottom-Right Corner   - hollow  - 8x8 (upper-right of 32x32)
;   0x6D (3488)  Horiz. Border Tile    - solid   - 32x2 (tile for text box edges)
;   0x6E (3520)  Left Vert. Border     - solid   - 2x32 (left edge of text box)
;   0x6F (3552)  Right Vert. Border    - solid   - 2x32 (right edge of text box)
;;              AI Contributions: Copilot generated gen_sprites_coe.py which
;                produced this file from bigfont.coe and the original
;                guitarSprites.coe.
; ============================================================================

memory_initialization_radix=16;
memory_initialization_vector=

; ============================================================================
; FONT GLYPHS  (IDs 0 - 94)  —  bigfont 16x16, left-justified in 32 bits
; ============================================================================

